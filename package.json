{
  "name": "@browsermcp/mcp",
  "version": "0.1.0",
  "description": "MCP server for browser automation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "browser-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --sourcemap && chmod +x dist/index.js",
    "watch": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "commander": "^13.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "mcp",
    "browser",
    "automation",
    "chrome",
    "extension"
  ],
  "homepage": "https://github.com/browsermcp/mcp",
  "license": "MIT"
}
